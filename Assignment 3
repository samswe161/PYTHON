def print_contacts(contacts):
    print("\\nMERGED CONTACT LIST")
    print("=" * 70)
    for index, contact in enumerate(contacts, start=1):
        print(f"{index}. Name: {contact['name']}")
        print("   Other name spellings:", contact["all_names"])
        print("   Phone numbers:", contact["phone_numbers"])
        print("   E-mails:", contact["emails"])
        print("   Sources:", contact["sources"])
 
 
def verify_small_example():
    """Check a small example whose expected merged result is known."""
    small = {
        "Phone A": [
            {"name": "Dr. Ravi", "phones": ["+91 98400 12345"],
             "emails": ["ravi@example.com"]}
        ],
        "Phone B": [
            {"name": "ravi kumar", "phones": ["9840012345"],
             "emails": ["ravi.work@example.com"]}
        ],
    }
    result = merge_contacts(small)
    assert len(result) == 1, "Expected one merged Ravi contact"
    assert len(result[0]["phone_numbers"]) >= 1
    assert "ravi@example.com" in result[0]["emails"]
    assert "ravi.work@example.com" in result[0]["emails"]
    print("\\nManual verification test: PASSED (two Ravi entries merged).")
 
 
def benchmark():
    """Measure merge time for 1,000 and 100,000 generated contacts."""
    print("\\nPERFORMANCE MEASUREMENT")
    for count in (1000, 100000):
        generated = []
        for i in range(count):
            generated.append({
                "name": f"Person {i}",
                "phones": [f"{9000000000 + (i % 100000000):010d}"],
                "emails": [f"person{i}@example.com"],
            })
 
        datasets = {"Generated Phone": generated}
        start = time.perf_counter()
        merged = merge_contacts(datasets)
        elapsed = time.perf_counter() - start
        print(f"{count:,} input contacts -> {len(merged):,} merged records")
        print(f"Elapsed time: {elapsed:.6f} seconds")
 
 
def main():
    contact_lists = make_test_data()
    merged_contacts = merge_contacts(contact_lists)
    print_contacts(merged_contacts)
    verify_small_example()
    benchmark()
 
 
if __name__ == "__main__":
    main()
