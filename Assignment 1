    )
    display_result("TEST 1: APRIL, ABOVE BONUS THRESHOLD", april)
 
    # Test 2: June seasonal rate, exactly 500 litres: no bonus.
    june = calculate_payment(
        fat="3.80", snf="8.50", month=6, ten_day_litres="500.00"
    )
    display_result("TEST 2: JUNE, EXACTLY 500 LITRES", june)
 
    # Test 3: April seasonal rate, below threshold: no bonus.
    below = calculate_payment(
        fat="4.00", snf="8.55", month=4, ten_day_litres="450.00"
    )
    display_result("TEST 3: APRIL, BELOW BONUS THRESHOLD", below)
 
    # Test 4: month outside April-June; no invented rate is used.
    print("\\nTEST 4: OUTSIDE THE PROVIDED SEASON")
    try:
        calculate_payment(
            fat="4.20", snf="8.60", month=10, ten_day_litres="520.00"
        )
    except ValueError as error:
        print("Correctly handled:", error)
 
    # Test 5: invalid analyser reading.
    print("\\nTEST 5: INVALID FAT READING")
    try:
        calculate_payment(
            fat="four", snf="8.60", month=4, ten_day_litres="520.00"
        )
    except ValueError as error:
        print("Correctly handled:", error)
 
    # Assertions verify the threshold and payment calculations.
    assert april["bonus"] == Decimal("260.00")
    assert june["bonus"] == Decimal("0.00")
    assert below["bonus"] == Decimal("0.00")
    print("\\nAll programmed validation checks passed.")
 
 
